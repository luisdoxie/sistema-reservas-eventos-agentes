# Copia este archivo como .env y cambia los valores. No subas .env al repositorio.

# Token para entrar al panel de administración (/admin.html). Si lo dejas vacío,
# se genera uno temporal al arrancar y se imprime en la consola.
ADMIN_TOKEN=

# Ruta del archivo SQLite (por defecto backend/datos.db).
DB_PATH=

# Puerto del servidor (por defecto 5000).
PORT=5000

# Dirección donde escucha el servidor. Por defecto 127.0.0.1: solo accesible desde esta máquina.
# Pon 0.0.0.0 para que otros equipos de tu red entren con http://<IP-de-esta-máquina>:5000
# (sin HTTPS: solo en una red de confianza, y con ADMIN_TOKEN definido).
APP_HOST=127.0.0.1

# 1 = carga 3 eventos de demostración si la base está vacía; 0 = empezar sin datos.
SEMILLA_DEMO=1
